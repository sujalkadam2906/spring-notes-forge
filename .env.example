# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Model for lecture notes generation (verified on Free Tier)
GEMINI_MODEL=gemini-3.6-flash

# Fallback Model used if primary model fails permanently or exhausts retries
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen

# Optional API retry parameters
# GEMINI_MAX_RETRIES=5
# GEMINI_INITIAL_BACKOFF_SEC=15
