# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_api_key_here

# Primary Model for lecture notes generation
GEMINI_MODEL=gemini-3.6-flash

# Fallback Model #1 — used if primary model fails or exhausts retries
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen

# Fallback Model #2 — used if both primary and first fallback fail (optional)
# GEMINI_FALLBACK_MODEL_2=gemini-2.5-flash

# Retry and backoff configuration
# GEMINI_MAX_RETRIES=2              # Max retry attempts per model (default: 2)
# GEMINI_INITIAL_BACKOFF_SEC=5      # Base delay in seconds for exponential backoff (default: 5)
# GEMINI_MAX_BACKOFF_SEC=20         # Maximum backoff delay in seconds (default: 20)
